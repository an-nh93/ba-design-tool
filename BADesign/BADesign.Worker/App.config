<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Cùng connection string với Web.config của BADesign (UiBuilderDb) -->
    <add name="UiBuilderDb"
         connectionString="Data Source=localhost\SQLEXPRESS01;Initial Catalog=BADeisgnTool;User ID=sa;Password=Lamgiconn1!#;MultipleActiveResultSets=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Chu kỳ polling (giây). Mặc định 10. -->
    <add key="WorkerPollIntervalSeconds" value="10" />
    <!-- Số job chạy đồng thời (vd 20–30 user mỗi user 1 job). Mặc định 15. -->
    <add key="MaxConcurrentJobs" value="15" />
    <!-- URL gốc web (vd https://localhost/BADesign). Có thì Worker gọi NotifyJobProgress → SignalR push % realtime lên mọi client. -->
    <add key="WebBaseUrl" value="http://cdv207.cadena.local:7979/" />
    <!-- Đường dẫn file log (vd WorkerLog.txt). Để trống = không ghi file. Log: job claimed, started, completed/failed. -->
    <add key="WorkerLogPath" value="WorkerLog.txt" />
  </appSettings>
</configuration>
